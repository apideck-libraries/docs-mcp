{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "api/**/*.ts", "bin/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "api/**/*.test.ts", "bin/**/*.test.ts"]
}

{
  "name": "@apideck/docs-mcp",
  "version": "0.4.0",
  "description": "MCP server that lets agents search and retrieve your documentation at query time instead of relying on stale training data.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "documentation",
    "search",
    "agents"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apideck-libraries/docs-mcp.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./webmcp": {
      "types": "./dist/src/webmcp.d.ts",
      "import": "./dist/src/webmcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "docs-mcp": "dist/bin/docs-mcp.js"
  },
  "files": [
    "dist/",
    "README.md",
    "docs/migrating-to-sdk-v2.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "start": "tsx bin/docs-mcp.ts start",
    "serve": "tsx bin/docs-mcp.ts serve",
    "audit": "tsx bin/docs-mcp.ts audit",
    "search": "tsx bin/docs-mcp.ts search",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@stricli/core": "1.3.0",
    "js-yaml": "4.3.2",
    "minisearch": "7.2.0",
    "zod": "4.6.2",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/node": "2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "tsx": "4.23.13",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "@modelcontextprotocol/client": "2.2.0"
  }
}

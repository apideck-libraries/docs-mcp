{
  "name": "docs-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets agents search and retrieve your documentation at query time instead of relying on stale training data.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "docs-mcp": "dist/bin/docs-mcp.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tests.mjs",
    "start": "tsx bin/docs-mcp.ts start",
    "serve": "tsx bin/docs-mcp.ts serve",
    "audit": "tsx bin/docs-mcp.ts audit",
    "search": "tsx bin/docs-mcp.ts search"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stricli/core": "^1.2.6",
    "@vercel/functions": "^3.4.4",
    "js-yaml": "^4.1.1",
    "minisearch": "^7.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint": "^9.17.0",
    "globals": "^16",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.1"
  }
}
